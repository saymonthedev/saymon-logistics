# ---------------------------------------------------------------------------
# Used by docker-compose.yml to wire up Postgres, the API and the web app.
# Copy this file to `.env` before running `docker-compose up`.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_USER=saymon
POSTGRES_PASSWORD=saymon_dev_pw
POSTGRES_DB=saymon_logistics
POSTGRES_PORT=5432

# --- API (NestJS) ---
API_PORT=3001
DATABASE_URL=postgresql://saymon:saymon_dev_pw@db:5432/saymon_logistics?schema=public
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h
COOKIE_NAME=saymon_session
CORS_ORIGIN=http://localhost:3000
SEED_ON_START=true

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
